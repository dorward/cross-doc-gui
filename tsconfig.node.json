{
	"extends": "./tsconfig.base.json",
	"compilerOptions": {
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"lib": ["ES2023", "DOM"],
		"types": ["node"],
		"rootDir": "src",
		"outDir": "dist",
		"sourceMap": true,
		"inlineSources": true
	},
	"include": [
		"src/main/**/*.ts",
		"src/preload/**/*.ts",
		"src/shared/**/*.ts",
		"src/utility/**/*.ts"
	]
}
