{
	"name": "cross-doc-gui",
	"version": "2.0.0",
	"description": "Graphical user interface for Cross-doc",
	"keywords": [],
	"license": "ISC",
	"author": "David Dorward <david@dorward.me.uk>",
	"files": [
		"dist",
		"README.md",
		"LICENSE.md"
	],
	"type": "module",
	"main": "dist/main/index.js",
	"scripts": {
		"start": "pnpm run build && node scripts/start.mjs",
		"build": "node scripts/build.mjs",
		"typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.renderer.json",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"test:electron": "pnpm run build && node tests/electron-smoke.mjs",
		"check:package-manager": "node scripts/check-package-manager.cjs",
		"lint": "oxlint --deny-warnings .",
		"lint:fix": "oxlint --fix --deny-warnings .",
		"format": "oxfmt --write .",
		"format:check": "oxfmt --check .",
		"test:pdf": "pnpm run build && node tests/real-pdf.mjs",
		"test:timeout": "CROSS_DOC_TEST_TIMEOUT=1 vitest run tests/compiler.test.mjs -t 'real Prince timeout'",
		"package": "pnpm run build && node scripts/package.mjs",
		"make": "pnpm run build && node scripts/package.mjs --make",
		"test:package": "node tests/package.mjs",
		"dev": "node scripts/dev.mjs",
		"test:dev": "node tests/dev.mjs",
		"test:parity": "pnpm run build && node tests/parity.mjs"
	},
	"dependencies": {
		"cross-doc": "file:../cross-doc",
		"primeicons": "8.0.2",
		"primereact": "10.9.9",
		"react": "19.3.1",
		"react-dom": "19.3.1"
	},
	"devDependencies": {
		"@electron-forge/cli": "8.0.1",
		"@electron-forge/core": "8.0.1",
		"@electron-forge/maker-zip": "8.0.1",
		"@electron/asar": "4.3.1",
		"@testing-library/dom": "10.4.2",
		"@testing-library/react": "16.3.3",
		"@types/node": "24.19.2",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"@vitejs/plugin-react": "6.1.2",
		"@vitest/coverage-v8": "5.0.5",
		"electron": "45.0.0",
		"esbuild": "0.28.2",
		"jsdom": "30.1.3",
		"oxfmt": "0.74.0",
		"oxlint": "1.89.0",
		"playwright": "1.64.1",
		"typescript": "7.0.2",
		"vite": "8.3.5",
		"vitest": "5.0.5"
	},
	"config": {
		"forge": "./forge.config.mjs"
	},
	"devEngines": {
		"packageManager": {
			"name": "pnpm",
			"version": "12.14.0",
			"onFail": "error"
		}
	},
	"engines": {
		"node": ">=24.22.0"
	},
	"packageManager": "pnpm@12.14.0",
	"productName": "Cross-Doc"
}
